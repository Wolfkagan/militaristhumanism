{
  "name": "militaristhumanism-community",
  "version": "0.1.0-community.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788 --var APP_ENV:development --var AUTH_ALLOWED_HOSTS:0.0.0.0,127.0.0.1,localhost --var AUTH_BASE_FALLBACK:http://0.0.0.0:8788",
    "dev:e2e": "node scripts/start_e2e_server.mjs",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler-worker-check",
    "build:worker:preview": "wrangler deploy --dry-run --env preview --outdir .wrangler-worker-preview-check",
    "build:worker:production": "wrangler deploy --dry-run --env production --outdir .wrangler-worker-production-check",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:recovery": "pwsh -NoLogo -NoProfile -File ./scripts/rehearse_d1_recovery.ps1",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --env preview --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote"
  },
  "dependencies": {
    "better-auth": "^1.6.29",
    "hono": "^4.13.2",
    "jose": "^6.2.10",
    "markdown-it": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260827.1",
    "@playwright/test": "^1.62.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.127.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true,
    "workerd@1.20260826.1": true
  }
}
